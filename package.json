{
  "name": "hypebound",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "HYPEBOUND — a comedic internet-culture collectible card game. Deterministic rules engine + three.js battle board.",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "validate": "vitest run tests/data-validation.test.ts",
    "balance": "node scripts/balance.mjs",
    "verify:ui": "node scripts/verify-ui.mjs",
    "verify:art": "node scripts/verify-art.mjs",
    "verify:tutorial": "node scripts/verify-tutorial.mjs",
    "verify:stages": "node scripts/verify-tutorial-stages.mjs",
    "verify:puzzles": "node scripts/verify-puzzles.mjs",
    "verify:replays": "node scripts/verify-replays.mjs",
    "verify:lab": "node scripts/verify-lab.mjs",
    "verify:boss": "node scripts/verify-boss.mjs",
    "verify:doomscroll": "node scripts/verify-doomscroll.mjs",
    "story": "vitest run tests/story-scripts.test.ts tests/story-branch-truth.test.ts",
    "verify:story": "node scripts/verify-story.mjs",
    "lore": "vitest run tests/card-lore.test.ts tests/mastery.test.ts",
    "cards": "vitest run tests/card-text.test.ts tests/data-validation.test.ts",
    "verify:cards": "node scripts/preview-card-detail.mjs",
    "verify:shop": "node scripts/verify-shop.mjs",
    "verify:tour": "node scripts/verify-tour.mjs",
    "verify:missions": "node scripts/verify-missions.mjs",
    "verify:mastery": "node scripts/verify-mastery.mjs",
    "verify:cosmetics": "node scripts/verify-cosmetics.mjs",
    "verify:achievements": "node scripts/verify-achievements.mjs",
    "verify:screens": "node scripts/verify-screens.mjs",
    "verify:pass": "node scripts/verify-pass.mjs",
    "verify:banner": "node scripts/verify-banner.mjs",
    "verify:inbox": "node scripts/verify-inbox.mjs",
    "verify:news": "node scripts/verify-news.mjs",
    "verify:fairness": "node scripts/verify-fairness.mjs",
    "verify:a11y": "node scripts/verify-a11y.mjs",
    "verify:gauntlet": "node scripts/verify-gauntlet.mjs",
    "verify:mobile": "node scripts/verify-mobile.mjs",
    "verify:keyboard": "node scripts/verify-keyboard.mjs",
    "verify:decks": "node scripts/verify-decks.mjs",
    "verify:events": "node scripts/verify-events.mjs",
    "verify:remix": "node scripts/verify-remix.mjs",
    "verify:custom": "node scripts/verify-custom.mjs"
  },
  "dependencies": {
    "three": "^0.170.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/three": "^0.170.0",
    "playwright-core": "^1.62.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
